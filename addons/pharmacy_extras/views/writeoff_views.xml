<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pharmacy_writeoff_list" model="ir.ui.view">
        <field name="name">pharmacy.writeoff.list</field>
        <field name="model">pharmacy.writeoff</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="expiration_date"/>
                <field name="reason"/>
                <field name="user_id"/>
                <field name="scrap_id"/>
            </list>
        </field>
    </record>

    <record id="pharmacy_writeoff_search" model="ir.ui.view">
        <field name="name">pharmacy.writeoff.search</field>
        <field name="model">pharmacy.writeoff</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="lot_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_writeoff" model="ir.actions.act_window">
        <field name="name">Write-offs</field>
        <field name="res_model">pharmacy.writeoff</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_pharmacy_writeoff"
              name="Expired Write-offs"
              parent="stock.menu_warehouse_report"
              action="action_pharmacy_writeoff"
              sequence="60"/>
</odoo>