<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="stock_lot_expiring_list" model="ir.ui.view">
        <field name="name">stock.lot.expiring.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list default_order="expiration_date asc" decoration-danger="product_expiry_alert">
                <field name="product_expiry_alert" column_invisible="1"/>
                <field name="name" string="Lot"/>
                <field name="product_id"/>
                <field name="expiration_date"/>
                <field name="product_qty" string="On Hand"/>
            </list>
        </field>
    </record>

    <!-- Search view with filters -->
    <record id="stock_lot_expiring_search" model="ir.ui.view">
        <field name="name">stock.lot.expiring.search</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Lot"/>
                <field name="product_id"/>
                <filter name="in_stock" string="In Stock"
                        domain="[('product_qty', '&gt;', 0)]"/>
                <separator/>
                <filter name="expired" string="Expired"
                        domain="[('expiration_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="expiring_30" string="Expiring within 30 days"
                        domain="[('expiration_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('expiration_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="expiring_60" string="Expiring within 60 days"
                        domain="[('expiration_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('expiration_date', '&lt;=', (context_today() + datetime.timedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter name="expiring_90" string="Expiring within 90 days"
                        domain="[('expiration_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('expiration_date', '&lt;=', (context_today() + datetime.timedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action and menu -->
    <record id="action_expiring_lots" model="ir.actions.act_window">
        <field name="name">Expiring Soon</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('stock_lot_expiring_list')})]"/>
        <field name="search_view_id" ref="stock_lot_expiring_search"/>
        <field name="context">{'search_default_in_stock': 1, 'search_default_expiring_90': 1}</field>
    </record>

    <menuitem id="menu_expiring_lots"
              name="Expiring Soon"
              parent="stock.menu_warehouse_report"
              action="action_expiring_lots"
              sequence="50"/>
</odoo>