<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="config_expiry_alert_days" model="ir.config_parameter">
            <field name="key">pharmacy_extras.expiry_alert_days</field>
            <field name="value">60</field>
        </record>

        <record id="ir_cron_pharmacy_expiry_alert" model="ir.cron">
            <field name="name">Pharmacy: Expiry Alerts</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_pharmacy_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>